# Copiez ce fichier en .env.local et complétez les valeurs.

# URL publique du site (SEO, sitemap). Facultatif sur Vercel.
NEXT_PUBLIC_SITE_URL=https://votre-site.vercel.app

# Formulaire de contact — clé gratuite sur https://web3forms.com
# Sans clé, la page Contact affiche simplement votre adresse e-mail.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Decap CMS en production (connexion GitHub) — voir README, section « CMS en ligne ».
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
