# Copiez ce fichier en .env.local et complétez les valeurs.

# URL publique du site (SEO, sitemap). Par défaut : https://www.lamoureux-lucas.com sur Vercel
# (voir src/lib/site-url.ts). À ne définir que pour forcer une autre adresse.
NEXT_PUBLIC_SITE_URL=

# Formulaire de contact — clé gratuite sur https://web3forms.com
# Sans clé, la page Contact affiche simplement votre adresse e-mail.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Decap CMS en production (connexion GitHub) — voir README, section « CMS en ligne ».
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google Search Console : code de vérification (valeur « content » de la balise HTML).
GOOGLE_SITE_VERIFICATION=
